# ===========================================
# MT ECO SYSTEM - Root .gitignore (monorepo)
# ===========================================

# Dependencies (all packages)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
dist-ssr/
.next/
out/
build/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# OS / Editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/
.nyc_output/

# Misc
*.pem
*.tsbuildinfo

# Legacy / old builds (optional to keep the static wallet/ folder in memetorrent-react if needed)
# memetorrent-react/wallet/static   # commented - decide per case

# Keep package-lock.json files (they are useful)
!package-lock.json
!yarn.lock
!pnpm-lock.yaml
