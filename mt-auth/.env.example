# mt-auth production config for Contabo VPS etc.
PORT=4002
# Use a free port different from mt-core (e.g. if core is 4001, use 4002).
# Comma separated, no spaces. Include your wallet frontend domains + local dev.
# The server now auto-allows any *.vercel.app preview so you don't need to list every hash.
CORS_ORIGINS=https://infinite-wallet.vercel.app,http://localhost:5173,https://yourdomain.com
DATA_DIR=/opt/mt-ecosystem/mt-auth/data
# Optional
# NODE_ENV=production
