# mt-auth production config for Contabo VPS etc.
PORT=4002
# Use a free port different from mt-core (e.g. if core is 4001, use 4002).
# Comma separated, no spaces. Include your wallet frontend domains.
CORS_ORIGINS=https://infinite-wallet.vercel.app,https://yourdomain.com
DATA_DIR=/opt/mt-ecosystem/mt-auth/data
# Optional
# NODE_ENV=production
