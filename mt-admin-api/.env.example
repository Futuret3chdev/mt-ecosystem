PORT=4003
ADMIN_API_KEY=change-this-to-a-strong-secret-for-full-admin
# Separate key for developers / testers. Use this in the dashboard login form
# so you never have to share or hardcode the master ADMIN_API_KEY.
# It grants the same read access for /api/admin/* (globe, events, playground, etc.)
# but keeps your real master password private.
TEST_API_KEY=change-this-to-a-different-strong-secret-for-devs
DB_PATH=./mt-admin.db
ALLOWED_ORIGINS=https://memetorrent.futuret3ch.com.au,https://wallet.futuret3ch.com.au,http://localhost:3000,http://localhost:5173

# For future webhooks / bots (optional)
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
