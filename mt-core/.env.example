# mt-core production config for Contabo VPS etc.
PORT=4001
# Use a free port (4000 and many others are likely taken by your other games on the busy Contabo VPS).
# Comma separated, no spaces. Include your wallet frontend domains.
CORS_ORIGINS=https://infinite-wallet.vercel.app,http://localhost:5173,https://yourdomain.com
# The server now auto-allows any *.vercel.app preview (new deploy hashes etc.) so you usually don't need to list them.
DATA_DIR=/opt/mt-ecosystem/mt-core/data
# Optional: customize network name
# NETWORK_NAME=MT Mainnet
# NETWORK_ID=mt-mainnet-1
